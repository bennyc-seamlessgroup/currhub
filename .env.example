# Public testnet RPC only. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# Optional server-side RPC for public swap quotes. Never prefix a private key with NEXT_PUBLIC_.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Airdrop: create a Supabase project, run supabase/airdrop.sql, then set these server-only values.
# Use the Supabase Project URL and a new sb_secret_ key from Settings > API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate with: openssl rand -hex 32
AIRDROP_AUTH_SECRET=
# Comma-separated public Sepolia admin wallet addresses. Include the wallet that owns uCURR.
ADMIN_WALLETS=
